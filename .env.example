# QUIRO Book Marketplace — Environment Template
NODE_ENV=production
PORT=5000

# Database Configuration (MySQL / TiDB Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=quiro
DB_SSL=false

# Security & Authentication
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
LOG_LEVEL=info

# Payment Gateway (Razorpay Test Mode / Production)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=quiro_test_webhook_secret_placeholder
SWAP_SHIPPING_FEE=79.00

# Google OAuth (Optional - For Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# AI Features (Optional - OpenAI Provider)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_MODEL=gpt-4o-mini

# Cloudinary Media Storage (Optional - Local disk storage fallback used if omitted)
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Frontend App URL
CLIENT_URL=http://localhost:5173
