# QUIRO Book Marketplace — Staging Environment Template
NODE_ENV=staging
PORT=5000

# Staging MySQL
DB_HOST=staging-db.internal
DB_USER=quiro_staging_user
DB_PASSWORD=your_staging_secure_password
DB_NAME=quiro_staging

# Staging JWT
JWT_SECRET=staging_jwt_secret_minimum_32_characters_long_abcde
LOG_LEVEL=info

# Staging Redis Cluster
REDIS_HOST=staging-redis.internal
REDIS_PORT=6379

# Razorpay Test / Sandbox Mode Keys
RAZORPAY_KEY_ID=rzp_test_staging_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_staging_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=quiro_test_webhook_secret_placeholder
SWAP_SHIPPING_FEE=79.00

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# AI Features
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_MODEL=gpt-4o-mini

# Staging Cloud Media Storage
CLOUDINARY_CLOUD_NAME=quiro-staging
CLOUDINARY_API_KEY=placeholder_staging_key
CLOUDINARY_API_SECRET=placeholder_staging_secret

CLIENT_URL=https://staging.quiro.in
