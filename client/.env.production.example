# QUIRO Frontend Production Environment Template
# -------------------------------------------------------------
# Base API URL:
# For production deployments using Docker Compose and the Nginx reverse proxy,
# use relative '/api' so that requests are routed to the same origin without CORS issues.
# For decoupled architectures (e.g. standalone CDN + remote API), set to full HTTPS URL.
VITE_API_URL=/api

# Google OAuth 2.0 Client ID:
# Required for Google Sign-In in production. Obtain from Google Cloud Console.
# Ensure authorized JavaScript origins include your production domain.
VITE_GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com
