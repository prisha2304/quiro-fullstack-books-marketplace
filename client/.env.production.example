# QUIRO Frontend Production Environment Template (Vercel)
# -------------------------------------------------------------
# 1. Backend API Base URL:
# For Vercel + Render decoupled deployment, set to your Render service API URL:
VITE_API_URL=https://your-render-service.onrender.com/api
# (If deploying via Docker Compose + Nginx on same origin, use: /api)

# 2. Backend Socket.IO URL:
# Optional if VITE_API_URL is a full HTTPS URL (SocketContext automatically derives
# the origin by stripping /api). Set explicitly if WebSockets use a different host:
VITE_SOCKET_URL=https://your-render-service.onrender.com

# 3. Google OAuth 2.0 Client ID:
# Required for Google Sign-In in production. Obtain from Google Cloud Console.
# Ensure Authorized JavaScript origins include your Vercel production domain.
VITE_GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com
