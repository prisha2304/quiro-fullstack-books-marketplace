# QUIRO Book Marketplace — Development Environment Template
NODE_ENV=development
PORT=5000

# Local MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_dev_password
DB_NAME=booknest_chatgpt_ag

# JWT Authentication
JWT_SECRET=dev_jwt_secret_minimum_32_characters_long_12345
LOG_LEVEL=debug

# Redis Cache (Optional - In-Memory Fallback Active)
REDIS_HOST=localhost
REDIS_PORT=6379

# Mock / Sandbox Payment Keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=quiro_test_webhook_secret_placeholder
SWAP_SHIPPING_FEE=79.00

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# AI Features (Optional)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_MODEL=gpt-4o-mini

# Local Uploads Storage Fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLIENT_URL=http://localhost:5173
