# QUIRO Book Marketplace — Production Environment Template
NODE_ENV=production
PORT=5000

# Production Database (TiDB Cloud / Managed MySQL)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=quiro_prod_admin
DB_PASSWORD=your_ultra_secure_prod_password_here
DB_NAME=quiro
DB_SSL=true
# DB_CA_PATH=certs/ca.pem

# Production Security
JWT_SECRET=production_jwt_secret_must_be_rotated_and_stored_in_vault
LOG_LEVEL=warn

# Razorpay Live Production Keys
RAZORPAY_KEY_ID=rzp_live_placeholder_production_key
RAZORPAY_KEY_SECRET=rzp_live_placeholder_production_secret
RAZORPAY_WEBHOOK_SECRET=quiro_live_webhook_secret_placeholder
SWAP_SHIPPING_FEE=79.00

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# AI Features
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_MODEL=gpt-4o-mini

# Production Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=quiro-production
CLOUDINARY_API_KEY=placeholder_prod_cloudinary_key
CLOUDINARY_API_SECRET=placeholder_prod_cloudinary_secret

CLIENT_URL=https://quiro.in
